    .maintain {
        display: flex;
        justify-content: space-evenly;
        align-items: center;
        width: 100%;
    }

    .copyright p{
        white-space: nowrap;
        color: whitesmoke;
    }

    .copyright{
        color: white;
        position: relative;
        left: 40%;
    }

    .footer .footer-widget .footer-logo{
