        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 10px;
    }

    .footer-bottom {
        text-align: center;
        display: flex;
        font-size: 15px;
        justify-content: center; /* Center Footer Bottom */
        border-top: none; /* Remove top border */
