<style>
    /* Footer Styling */
    .footer {
        background-color: #002d5f; /* Dark blue background for a professional look */
        color: #ffffff; /* White text color for contrast */
        padding: 30px 0;
        font-family: Arial, sans-serif;
    }


    .footer-about-content p {
        font-size: 14px;
        line-height: 1.6;
        color: #d3d3d3; /* Softer text color for readability */
        margin-bottom: 15px;
    }

    .footer-title {
        font-size: 18px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 15px;
        text-transform: uppercase;
    }

    .footer-menu ul,
    .footer-contact-info ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .footer-menu ul li,
        .footer-contact-info ul li {
            margin-bottom: 10px;
        }

            .footer-menu ul li a,
            .footer-contact-info ul li a {
                color: #b3c7e6; /* Light blue links */
                text-decoration: none;
                font-size: 14px;
                transition: color 0.3s ease;
            }

                .footer-menu ul li a:hover,
                .footer-contact-info ul li a:hover {
                    color: #ffffff; /* Hover effect for better interactivity */
                }

    .social-icon ul {
        list-style: none;
        padding: 0;
        display: flex;
        gap: 15px;
        margin-top: 10px;
    }

        .social-icon ul li a {
            color: #b3c7e6;
            font-size: 18px;
            transition: color 0.3s ease;
        }

            .social-icon ul li a:hover {
                color: #ffffff;
            }


    .policy-menu {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        justify-content: center;
        gap: 15px;
    }

        .policy-menu li a {
            color: #b3c7e6;
            text-decoration: none;
            transition: color 0.3s ease;
        }

            .policy-menu li a:hover {
                color: #ffffff;
            }

    .maintain{
        justify-content: center;
        align-content: center;
        align-items: center;
    }

    /* them  */

