@{
    Layout = "~/Views/Shared/Layout_Admin.cshtml";  // Main layout
}

@section Styles {
    <style>
        .layout-default_body_main {
            width: 100%;
            padding: 20px;
            background-color: #f9f9f9;
        }

        /* Container for editing blog */
        .edit-blog-container {
            max-width: 600px;
            margin: 40px auto;
            padding: 30px;
            background-color: white;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            border-radius: 12px;
        }

        /* Header */
        h1 {
            text-align: center;
            margin-bottom: 25px;
            color: #333;
            font-size: 1.8rem;
            font-weight: bold;
        }

        /* Form group */
        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            font-size: 1rem;
            color: #555;
        }

        /* Input fields */
        input, textarea {
            width: 100%;
            padding: 12px;
            font-size: 1rem;
            border: 1px solid #ccc;
            border-radius: 8px;
            background-color: #f8f8f8;
            transition: border-color 0.3s ease;
        }

            input:focus, textarea:focus {
                border-color: #0D6EFD;
                outline: none;
                background-color: #fff;
            }

        /* Textarea for content */
        textarea {
            resize: vertical;
            height: 150px;
        }

        /* Save button */
        .save-button {
            padding: 12px;
            background-color: #0D6EFD;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            transition: background-color 0.3s ease;
        }

            .save-button:hover {
                background-color: #45a049;
            }
    </style>
}

<main class="layout-default_body_main">
    <h1>Chỉnh sửa thông tin blog</h1>

    <form asp-action="EditBlog" method="post" enctype="multipart/form-data">
        <input type="hidden" id="BlogId" name="BlogId" value="@Model.BlogId" />

        <div class="form-group">
            <label for="Title">Tiêu đề:</label>
            <input type="text" id="Title" name="Title" value="@Model.Title" placeholder="Nhập tiêu đề" class="form-control" />
        </div>

        <div class="form-group">
            <label for="ShortDescription">Mô tả ngắn:</label>
            <textarea id="ShortDescription" name="ShortDescription" placeholder="Nhập mô tả ngắn" class="form-control">@Model.ShortDescription</textarea>
        </div>

        <div class="form-group">
            <label for="Content">Nội dung:</label>
            <textarea id="Content" name="Content" placeholder="Nhập nội dung" class="form-control">@Model.Content</textarea>
        </div>

        <div class="form-group">
            <label for="Image">URL hình ảnh hiện tại:</label>
            <input type="text" id="Image" name="Image" value="@Model.Image" placeholder="URL hình ảnh hiện tại" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label for="CreateDate">Ngày tạo:</label>
            <input type="datetime-local" id="CreateDate" name="CreateDate" value="@Model.CreateDate?.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
        </div>

        <div class="form-group">
            <label for="ImageUpload">Tải ảnh mới lên:</label>
            <input type="file" id="ImageUpload" name="ImageUpload" class="form-control" />
        </div>

        <button type="submit" class="save-button">Lưu thay đổi</button>
    </form>
</main>
