@* @{
    Layout = "Layout_Admin";  // Layout chính mà bạn đã định nghĩa
}
@section Scripts {
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}

@model test2.Data.Patient

@section Styles {
    <style>
        .layout-default_body_main {
            width: 100%;
        }

        form {
            margin: 20px;
            background-color: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .first-text {
            font-size: xx-large;
            color: #4A5568;
            margin-bottom: 20px;
        }

        .section {
            margin-bottom: 40px;
        }

        .border {
            border-bottom: 1px solid #ccc;
            padding-bottom: 20px;
        }

        .grid-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .grid-item {
            display: flex;
            flex-direction: column;
        }

        .grid-item-full {
            grid-column: span 2;
            display: flex;
            flex-direction: column;
        }

        label {
            font-weight: 500;
            margin-bottom: 8px;
        }

        input,
        textarea,
        select {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
            width: 100%;
            font-size: 14px;
            margin-bottom: 12px;
        }

        .flex-container {
            display: flex;
            align-items: center;
        }

        .photo-icon {
            width: 48px;
            height: 48px;
            background-color: #ccc;
            border-radius: 50%;
        }

        .change-btn {
            margin-left: 12px;
            padding: 8px 16px;
            border: 1px solid #ccc;
            background-color: #fff;
            cursor: pointer;
            border-radius: 4px;
            transition: background-color 0.2s;
        }

            .change-btn:hover {
                background-color: #f0f0f0;
            }

        .submit-container {
            display: flex;
            justify-content: flex-end;
            gap: 16px;
            margin-top: 20px;
        }

        button {
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }

        .cancel-btn {
            background-color: #f0f0f0;
            color: #333;
            padding: 10px 10px;
            border: 10px;
        }

        .save-btn {
            background-color: #0D6EFD;
            color: #fff;
            padding: 10px 10px;
            border: 10px;
        }

            .save-btn:hover {
                background-color: #357ABD;
            }

        .cancel-btn:hover {
            background-color: #e0e0e0;
        }
    </style>
}

<main class="layout-default_body_main">
    <form method="post" asp-action="AddPatient">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <!-- Section 1: Patient Information -->
        <div class="section">
            <div class="">
                <h1 class="first-text">Patient Information</h1>


                <div class="grid-container">
                    <!-- Patient ID -->
                    <div class="grid-item">
                        <label for="AccountId">Account ID</label>
                        <input class="form-control" id="AccountId" name="AccountId" type="text" placeholder="Account ID" value="" />
                        <span class="text-danger"></span> <!-- Real-time error message container -->

                    </div>
                    <div class="grid-item">
                        <label asp-for="Pid">ID</label>
                        <input asp-for="Pid" class="form-control" placeholder="Patient ID" />
                        <span class="text-danger"></span> <!-- Real-time error message container -->
                    </div>

                    <!-- Full Name -->
                    <div class="grid-item">
                        <label asp-for="Name">Full Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Full Name" />
                        <span class="text-danger"></span> <!-- Real-time error message container -->
                    </div>

                    <!-- Phone -->
                    <div class="grid-item">
                        <label asp-for="Phone">Phone Number</label>
                        <input asp-for="Phone" class="form-control" type="tel" placeholder="Phone number" />
                        <span class="text-danger"></span> <!-- Real-time error message container -->
                    </div>

                    <!-- Gender -->
                    <div class="grid-item">
                        <label asp-for="Gender">Gender</label>
                        <select asp-for="Gender" class="form-control">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <!-- Date of Birth -->
                    <div class="grid-item">
                        <label asp-for="Dob">Date of Birth</label>
                        <input asp-for="Dob" class="form-control" type="date" />
                        <span class="text-danger"></span> <!-- Real-time error message container -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Submit Button -->
        <div class="submit-container">
            <button type="button" class="cancel-btn">Cancel</button>
            <button type="submit" class="save-btn">Save</button>
        </div>
    </form>
</main>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const accountIdInput = document.getElementById('AccountId');
        accountIdInput.addEventListener('input', function () {
            const value = accountIdInput.value;
            const regex = /^[A-Za-z]\d+$/;
            if (!value) {
                showError('AccountId', 'Account ID is required.');
            } else if (!regex.test(value)) {
                showError('AccountId', 'Account ID must start with a letter followed by digits.');
            } else {
                clearError('AId');
            }
        });

        // Real-time validation for Patient ID
        const patientIdInput = document.getElementById('Pid');
        patientIdInput.addEventListener('input', function () {
            const value = patientIdInput.value;
            const regex = /^[A-Za-z]\d+$/;
            if (!value) {
                showError('Pid', 'Patient ID is required.');
            } else if (!regex.test(value)) {
                showError('Pid', 'Patient ID must start with a letter followed by digits.');
            } else {
                clearError('Pid');
            }
        });

        // Real-time validation for Full Name
        const nameInput = document.getElementById('Name');
        nameInput.addEventListener('input', function () {
            const value = nameInput.value;
            if (!value) {
                showError('Name', 'Name is required.');
            } else if (value.length > 30) {
                showError('Name', 'Name cannot be longer than 30 characters.');
            } else if (!/^[A-Za-z\s]*$/.test(value)) {
                showError('Name', 'Name must contain only letters.');
            } else {
                clearError('Name');
            }
        });

        // Real-time validation for Phone
        const phoneInput = document.getElementById('Phone');
        phoneInput.addEventListener('input', function () {
            const value = phoneInput.value;
            const phoneRegex = /^\d{10}$/;
            if (!value) {
                showError('Phone', 'Phone number is required.');
            } else if (!phoneRegex.test(value)) {
                showError('Phone', 'Phone number must be 10 digits.');
            } else {
                clearError('Phone');
            }
        });

        // Real-time validation for Date of Birth
        const dobInput = document.getElementById('Dob');
        dobInput.addEventListener('input', function () {
            const dobValue = new Date(dobInput.value);
            const today = new Date();
            if (!dobInput.value) {
                showError('Dob', 'Date of Birth is required.');
            } else if (dobValue >= today) {
                showError('Dob', 'Date of Birth must be in the past.');
            } else {
                clearError('Dob');
            }
        });

        // Show error function
        function showError(elementId, message) {
            const errorElement = document.querySelector(`#${elementId} + .text-danger`);
            if (errorElement) {
                errorElement.textContent = message;
            }
        }

        // Clear error function
        function clearError(elementId) {
            const errorElement = document.querySelector(`#${elementId} + .text-danger`);
            if (errorElement) {
                errorElement.textContent = '';
            }
        }
    });
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const dobInput = document.getElementById('Dob');
        const ageLimit = 16; // Minimum age required

        dobInput.addEventListener('input', function () {
            const dobValue = new Date(dobInput.value);
            const today = new Date();
            const age = today.getFullYear() - dobValue.getFullYear();
            const ageMonthOffset = today.getMonth() - dobValue.getMonth();
            const isOldEnough = age > ageLimit || (age === ageLimit && ageMonthOffset >= 0);

            if (!dobInput.value) {
                showError('Dob', 'Date of Birth is required.');
            } else if (dobValue >= today) {
                showError('Dob', 'Date of Birth must be in the past.');
            } else if (!isOldEnough) {
                showError('Dob', 'Patient must be at least 16 years old.');
            } else {
                clearError('Dob');
            }
        });

        // Function to show error messages
        function showError(elementId, message) {
            const errorElement = document.querySelector(`#${elementId} + .text-danger`);
            if (errorElement) {
                errorElement.textContent = message;
            }
        }

        // Function to clear error messages
        function clearError(elementId) {
            const errorElement = document.querySelector(`#${elementId} + .text-danger`);
            if (errorElement) {
                errorElement.textContent = '';
            }
        }
    });
</script>

