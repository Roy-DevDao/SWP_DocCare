

﻿@{
    var doctors = ViewBag.Doctors as IEnumerable<test2.Data.Doctor>;

    var specialties = ViewBag.Specialties as IEnumerable<test2.Data.Specialty>;

    var post = ViewBag.Post as IEnumerable<test2.Data.Blog>;
}
@{
    Layout = "Layout_new";

    ViewData["Title"] = "Trang Chủ";
}

<style>
    .section-blogs .blog.grid-blog {
        display: flex;
        flex-direction: column;
        height: 100%; /* Đảm bảo các mục có cùng chiều cao */
    }

    .section-blogs .blog-image img {
        height: 200px; /* Chiều cao cố định cho hình ảnh */
        width: 100%;
        object-fit: cover; /* Đảm bảo hình ảnh không bị méo */
    }

    .section-blogs .blog-content {
        flex-grow: 1;
        padding: 15px;
    }

    .section-blogs .blog-title {
        max-height: 48px;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        font-weight: bold; /* In đậm tiêu đề */
    }

    .section-blogs .entry-meta {
        margin-bottom: 10px;
    }

    .section-blogs .blog-content p {
        max-height: 60px; /* Giới hạn chiều cao của đoạn mô tả */
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<section class="bg-half-260 d-table w-100" style="background: url('@Url.Content("~/assets/images/bg/banner.jpg")') center;">
    <div class="bg-overlay bg-overlay-"></div>
    <div class="container">
        <div class="row mt-5 mt-lg-0">
            <div class="col-12">
                <div class="heading-title">
                    <img src="assets/images/icon-logo.png" height="5" width="5" alt="">
                    <h4 class="display-4 fw-bold text-white title- mt-3 mb-4">
                        <br>
                        Hệ Thống Đăng Ký<br /> Chăm Sóc Trực Tuyến<br />
                    </h4>
                    <p class="para-desc text-white-50 mb-0">Nếu bạn hoặc người thân cần hỗ trợ ngay lập tức, điều trị khẩn cấp qua một cuộc tư vấn đơn giản.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container" style="position:relative; top:20px;">
        <div class="row justify-content-center">
            <div class="col-xl-10">
                <div class="features-absolute bg-white shadow rounded overflow-hidden card-group">
                    <div class="card border-0 bg-light p-4">
                        <i class="ri-heart-pulse-fill text-primary h2 mb-0"></i>
                        <h5 class="mt-1">Dịch Vụ Chăm Sóc Sức Khỏe</h5>
                        <p class="text-muted mt-2">Chúng tôi mang đến cho bạn những dịch vụ chất lượng cao nhất trên thị trường.</p>
                        <a asp-area="" asp-controller="Home" asp-action="ServiceList" class="text-primary">Tìm hiểu thêm <i class="ri-arrow-right-line align-middle"></i></a>
                    </div>

                    <div class="card border-0 p-4">
                        <i class="ri-dossier-fill text-primary h2 mb-0"></i>
                        <h5 class="mt-1">Đặt Lịch Trực Tuyến</h5>
                        <p class="text-muted mt-2">Đội ngũ bác sĩ của chúng tôi luôn sẵn sàng tư vấn và thăm khám cho bạn.</p>
                        <br>
                        <a asp-area="" asp-controller="Home" asp-action="DoctorList" class="text-primary">Tìm hiểu thêm <i class="ri-arrow-right-line align-middle"></i></a>
                    </div>

                    <div class="card border-0 bg-light p-4">
                        <i class="ri-time-fill text-primary h2 mb-0"></i>
                        <h5 class="mt-1">Giờ Hoạt Động</h5>
                        <ul class="list-unstyled mt-2">
                            <li class="d-flex justify-content-between">
                                <p class="text-muted mb-0">Thứ Hai - Thứ Sáu</p>
                                <p class="text-primary mb-0">8:00 - 20:00</p>
                            </li>
                            <li class="d-flex justify-content-between">
                                <p class="text-muted mb-0">Thứ Bảy</p>
                                <p class="text-primary mb-0">8:00 - 18:00</p>
                            </li>
                            <li class="d-flex justify-content-between">
                                <p class="text-muted mb-0">Chủ Nhật</p>
                                <p class="text-primary mb-0">8:00 - 14:00</p>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-20 mt-20">
        <div class="row align-items-center">
            <div class="col-lg-5 col-md-6">
                <div class="position-relative">
                    <img src="assets/images/about/about.jpg" class="img-fluid" alt="">
                    <div class="play-icon">
                        <a href="https://youtu.be/QIvIN8M91x4" class="play-btn video-play-icon">
                            <i class="mdi mdi-play text-primary rounded-circle bg-white title-bg- shadow"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 col-md-6 mt-4 mt-lg-0 pt- pt-lg-0">
                <div class="ms-lg-4">
                    <div class="section-title">
                        <h4 class="title mb-4">Tại Sao Chọn Doccare?</h4>
                        <p class="text-muted para-desc">Chúng tôi tập hợp đội ngũ các chuyên gia, bác sĩ, dược sĩ và y tá có chuyên môn cao, kỹ năng xuất sắc, tận tâm và chuyên nghiệp.</p>
                        <p class="text-muted para-desc mb-0">Luôn đặt bệnh nhân là trung tâm, Doccare cam kết cung cấp những dịch vụ chăm sóc sức khỏe tốt nhất cho khách hàng.</p>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a asp-area="" asp-controller="Home" asp-action="DoctorList" class="btn btn-primary">Xem thêm.. <i class="ri-arrow-right-line align-middle"></i></a>
            </div>
        </div>
    </div>
</section>


<section class="section home-tile-section">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-9 m-auto">
                <div class="section-header text-center">
                    <h2>Bạn đang tìm kiếm gì?</h2>
                </div>
                <div class="row">
                    <div class="col-lg-4 mb-3">
                        <div class="card text-center doctor-book-card">
                            <img src="~/Content/theme/img/doctors/doctor-07.jpg" alt="" class="img-fluid">
                            <div class="doctor-book-card-content tile-card-content-1">
                                <div>
                                    <h3 class="card-title mb-0">Gặp Bác sĩ</h3>
                                    <a asp-area="" asp-controller="Home" asp-action="DoctorList" class="btn book-btn1 px-3 py-2 mt-3" tabindex="0">Đặt Lịch Ngay</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 mb-3">
                        <div class="card text-center doctor-book-card">
                            <img src="~/Content/theme/img/img-pharmacy1.jpg" alt="" class="img-fluid">
                            <div class="doctor-book-card-content tile-card-content-1">
                                <div>
                                    <h3 class="card-title mb-0">Tìm Dịch vụ</h3>
                                    <a asp-area="" asp-controller="Home" asp-action="ServiceList" class="btn book-btn1 px-3 py-2 mt-3" tabindex="0">Tìm Ngay</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 mb-3">
                        <div class="card text-center doctor-book-card">
                            <img src="~/Content/theme/img/lab-image.jpg" alt="" class="img-fluid">
                            <div class="doctor-book-card-content tile-card-content-1">
                                <div>
                                    <h3 class="card-title mb-0">Gửi Liên hệ</h3>
                                    <a asp-area="" asp-controller="Home" asp-action="Contact" class="btn book-btn1 px-3 py-2 mt-3" tabindex="0">Liên Hệ</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section-specialities">
    <div class="container-fluid">
        <div class="section-header text-center">
            <h2>Phòng Khám và Chuyên Khoa</h2>
            <p class="sub-title">Đội ngũ Doccare luôn mang đến cho bạn các dịch vụ chăm sóc sức khỏe hiện đại và chất lượng nhất, với các bác sĩ chuyên môn trong nhiều lĩnh vực.</p>
        </div>
        <div class="row justify-content-center">
            <div class="col-md-9">
                <div class="specialities-slider slider">
                    @if (specialties != null && specialties.Any())

                    {
                        @foreach (var specialty in specialties)

                        {
                            <a asp-controller="Home" asp-action="ServiceDetail" asp-route-id="@specialty.SpecialtyId">
                                <div class="speicality-item text-center">
                                    <div class="speicality-img">
                                        <img src="@specialty.SpecialtyImg" class="img-fluid" alt="Chuyên khoa @specialty.SpecialtyName">
                                        <span><i class="fa fa-circle" aria-hidden="true"></i></span>
                                    </div>
                                    <p>@specialty.SpecialtyName</p>
                                </div>
                            </a>
                        }
                    }

                    else

                    {
                        <p>Hiện chưa có dịch vụ nào.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section-doctor">
    <div class="container-fluid" style="padding:20px; width: 90%; height:80%;">
        <div class="row">
            <div class="col-lg-4">
                <div class="section-header ">
                    <h2>Đặt lịch với Bác sĩ của Chúng tôi</h2>
                    <p>Dịch vụ của bác sĩ</p>
                </div>
                <div class="about-content">
                    <p>Doccare tập hợp một đội ngũ chuyên gia, bác sĩ, dược sĩ và y tá được đào tạo bài bản,</p>
                    <p>từ cơ bản đến nâng cao, cả ở Việt Nam và tại các quốc gia có nền y học tiên tiến như Mỹ, Anh, Pháp...</p>
                    <a asp-controller="Patient" asp-action="Invoice" asp-route-orderId="ord4600784">Đọc thêm..</a>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="doctor-slider slider">
                    @foreach (var doctor in doctors)

                    {
                        <div class="profile-widget" style="min-height: 520px;">
                            <div class="doc-img" height="228.4">
                                <a asp-area="" asp-controller="Home" asp-action="DoctorDetail" asp-route-id="@doctor.Did">
                                    <img class="img-fluid" alt="Ảnh người dùng" src="@doctor.DoctorImg">
                                </a>
                                <a href="javascript:void(0)" class="fav-btn">
                                    <i class="far fa-bookmark"></i>
                                </a>
                            </div>
                            <div class="pro-content" style="min-height: 210px;">
                                <h3 class="title">
                                    <a asp-area="" asp-controller="Home" asp-action="DoctorDetail" asp-route-id="@doctor.Did">@doctor.Name</a>
                                    <i class="fas fa-check-circle verified"></i>
                                </h3>
                                <p class="speciality">@doctor.Phone</p>
                                <div class="rating">
                                    <i class="fas fa-star filled"></i>
                                    <i class="fas fa-star filled"></i>
                                    <i class="fas fa-star filled"></i>
                                    <i class="fas fa-star filled"></i>
                                    <i class="fas fa-star filled"></i>
                                    <span class="d-inline-block average-rating">(17)</span>
                                </div>
                                <ul class="available-info">
                                    <li>
                                        <i class="fas fa-map-marker-alt"></i> Đà Nẵng
                                    </li>
                                    <li>
                                        <i class="fa fa-dashboard"></i> @doctor.Dob
                                    </li>
                                </ul>
                            </div>
                            <div class="control">
                                <div class="row row-sm">
                                    <div class="col-6">
                                        <a asp-area="" asp-controller="Home" asp-action="DoctorDetail" asp-route-id="@doctor.Did" class="btn view-btn">Xem Hồ Sơ</a>
                                    </div>
                                    <div class="col-6">
                                        <a href="https://localhost:7248/Patient/BookingAppointment?doctorid=@doctor.Did" class="btn book-btn">Đặt Lịch</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section-blogs">
    <div class="container-fluid">

        <div class="section-header text-center">
            <h2>Tin Tức</h2>
            <p class="sub-title">Một số tin tức Y Tế nổi bật trong thời gian qua.</p>
        </div>

        <div class="row blog-grid-row">

            @foreach (var art in post)
            {
                <div class="col-md-6 col-lg-3 col-sm-12">

                    <div class="blog grid-blog">
                        <div class="blog-image">
                            <a asp-controller="Home" asp-action="BlogDetail" asp-route-itemid="@art.BlogId"><img class="img-fluid" src="@art.Image" alt="@art.Title"></a>
                        </div>
                        <div class="blog-content">
                            <ul class="entry-meta meta-item">
                                <li>
                                    <div class="post-author">
                                        <a href="#">
                                            <img src="@art.Image" alt="Post Author"> <span>@art.CreateBy</span>
                                        </a>
                                    </div>
                                </li>
                                <li><i class="far fa-clock"></i> @art.CreateDate.ToString()</li>
                            </ul>
                            <h3 class="blog-title"><a asp-controller="Home" asp-action="BlogDetail" asp-route-itemid="@art.BlogId">@art.Title</a></h3>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="view-all text-center">
            <a asp-controller="Home" asp-action="Blog" class="btn btn-primary">View All</a>
        </div>
    </div>
</section>
<!-- Video-->
<section class="section pt-0">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-8 text-center">
                <div class="video-solution-cta position-relative" style="z-index: 1;">
                    <div class="position-relative">
                        <img src="~/assets/images/bg/banner.jpg" class="img-fluid rounded-md shadow-lg" alt="">
                        <div class="play-icon">
                            <a href="https://youtu.be/cAdQFXWJD30" class="play-btn video-play-icon">
                                <i class="mdi mdi-play text-primary rounded-circle bg-white title-bg- shadow-lg"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="feature-posts-placeholder bg-primary"></div>
    </div>
</section>



@section Scripts

{
    <script src="~/Content/theme/js/slick.js"></script>
    <script src="~/Content/theme/js/script.js"></script>

    <script>
        $(document).ready(function () {
            // Cấu hình slider cho dịch vụ
            $('.service-slider').slick({
                slidesToShow: 3,
                slidesToScroll: 3,
                autoplay: false,
                infinite: true, // Thêm thuộc tính này
                dots: false,
                arrows: true,
                prevArrow: '<button type="button" class="slick-prev"></button>',
                nextArrow: '<button type="button" class="slick-next"></button>',
                responsive: [
                    {
                        breakpoint: 1024,
                        settings: {
                            slidesToShow: 3,
                            slidesToScroll: 3
                        }
                    },
                    {
                        breakpoint: 600,
                        settings: {
                            slidesToShow: 2,
                            slidesToScroll: 2
                        }
                    },
                    {
                        breakpoint: 480,
                        settings: {
                            slidesToShow: 1,
                            slidesToScroll: 1
                        }
                    }
                ]
            });

            // Cấu hình slider cho bác sĩ
            $('.doctor-slider').slick({
                slidesToShow: 4, // Thay đổi số lượng hiển thị nếu cần
                slidesToScroll: 4,
                autoplay: false,
                dots: false,
                arrows: true,
                prevArrow: '<button type="button" class="slick-prev"></button>',
                nextArrow: '<button type="button" class="slick-next"></button>',
                responsive: [
                    {
                        breakpoint: 1024,
                        settings: {
                            slidesToShow: 3,
                            slidesToScroll: 3
                        }
                    },
                    {
                        breakpoint: 600,
                        settings: {
                            slidesToShow: 2,
                            slidesToScroll: 2
                        }
                    },
                    {
                        breakpoint: 480,
                        settings: {
                            slidesToShow: 1,
                            slidesToScroll: 1
                        }
                    }
                ]
            });
        });


    </script>
} 