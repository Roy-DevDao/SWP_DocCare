<button id="error-modal-button" data-modal-target="error-modal" data-modal-toggle="error-modal" class="hidden block text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" type="button">
	Toggle modal
</button>

<div id="error-modal" tabindex="-1" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
	<div class="relative p-4 w-full max-w-md max-h-full">
		<div class="relative bg-white rounded-lg shadow dark:bg-gray-700">
			<button type="button" class="absolute top-3 end-2.5 text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-hide="error-modal">
				<svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6" />
				</svg>

				<span class="sr-only">Đóng</span>
			</button>
			<div class="p-4 md:p-5 text-center">
				<div id="fb-success" class="hidden">
					<svg class="mx-auto mb-4 text-green-400 w-12 h-12 dark:text-gray-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
					</svg>

				</div>
				<div id="fb-fail" class="hidden">
					<svg class="mx-auto mb-4 text-gray-400 w-12 h-12 dark:text-gray-200" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
						<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11V6m0 8h.01M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
					</svg>
				</div>
				<h3 id="context-notify" class="mb-5 text-lg font-normal text-gray-500 dark:text-gray-400"></h3>
			</div>
		</div>
	</div>
</div>



<script>
	const doctorid = document.getElementById("doctor_id").value;
	function sendReview() {

		const desc = document.getElementById("review_desc").value.trim();
		const stars = document.querySelectorAll(".star_doc");
		var star = 0;
		stars.forEach(element => {
			if (element.checked) {
				star = parseInt(element.value);
				return;
			}
		});

		if (desc == "") {
			document.getElementById("context-notify").innerHTML = "Don't let review blank";

			document.getElementById("fb-success").classList.add("hidden");
			document.getElementById("fb-fail").classList.remove("hidden");
			document.getElementById("error-modal-button").click();
			return;
		}
		else if (!Number.isInteger(star) || star <= 0 || star > 5) {
			console.log(Number.isInteger(star), "==", star);
			document.getElementById("context-notify").innerHTML = "You have leave star feedback";
			document.getElementById("fb-success").classList.add("hidden");
			document.getElementById("fb-fail").classList.remove("hidden");
			document.getElementById("error-modal-button").click();
			return;
		}

		const formData = { message: desc, doctorid: doctorid, star: star }
		$.ajax({
			url: '/Patient/SendMessage',  // URL of the action method in the server
			type: 'POST',
			data: formData,
			success: function ({ success, name, description, star, ngay, image }) {
				document.getElementById("context-notify").innerHTML = "Send review successfully";
				document.getElementById("fb-success").classList.remove("hidden");
				document.getElementById("fb-fail").classList.add("hidden");
				document.getElementById("error-modal-button").click();
				const tableBody = document.getElementById("tb-feedback");

				const date = ngay.split(' ')[0];

				// Define the new row HTML as a template string
				const newRowHTML = `
					<li>
						<div class="comment">
							<img class="avatar avatar-sm rounded-circle" alt="User Image" src="${image ? image : "https://tse1.mm.bing.net/th?id=OIP.zP1mlHnV1bpgODW8gvQSFQHaIP&pid=Api&P=0&h=180"}">
							<div class="comment-body">
								<div class="meta-data">
									<span class="comment-author">${name}</span>
										<span class="comment-date">${date}</span> <!-- Format Date -->
									<div class="review-count rating">
										${getStars(star)} <!-- Dynamically generate stars -->
									</div>
								</div>
								<p class="comment-content">${description}</p>
								<div class="comment-reply">
									<a class="comment-btn" href="#">
										<i class="fas fa-reply"></i> Reply
									</a>
									<p class="recommend-btn">
										<span>Recommend?</span>
										<a href="#" class="like-btn">
											<i class="far fa-thumbs-up"></i> Yes
										</a>
										<a href="#" class="dislike-btn">
											<i class="far fa-thumbs-down"></i> No
										</a>
									</p>
								</div>
							</div>
						</div>
					</li>
				`;

				// Insert the new row HTML at the beginning of the tbody
				tableBody.insertAdjacentHTML("afterbegin", newRowHTML);
				document.getElementById("review_desc").value = "";
				stars.forEach(element => {
					if (element.checked) {
						element.checked = false;
						return;
					}
				});



			},
			error: function (error) {
				console.log('Error:', error); // Error handling
			}
		});


	}
	function getStars(star) {
		let starsHTML = '';
		for (let i = 0; i < star; i++) {
			starsHTML += '<i class="fas fa-star filled"></i>';
		}
		for (let i = star; i < 5; i++) {
			starsHTML += '<i class="fas fa-star"></i>';
		}
		return starsHTML;
	}
</script>