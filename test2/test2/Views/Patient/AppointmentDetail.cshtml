@model test2.Data.Order﻿
@{
	Layout = "Layout_Patient";
	var status = Model.Option.Status;
}

<div class="max-w-3xl mt-16 mx-auto bg-white p-6 rounded-lg shadow-md space-y-6">
	<!-- Phần tiêu đề -->
	<div class="flex items-center justify-between">
		<h2 class="text-xl font-semibold">Chi tiết cuộc hẹn</h2>
		<div class="flex items-center space-x-2">
			<span class="px-2 py-1 text-xs bg-gray-200 rounded">@status</span>
			@if (status == "Pending" || status == "Confirm")
			{
				<button onclick="cancelAppointment()" class="px-2 py-1 text-xs bg-red-500 rounded">Hủy</button>
			}
		</div>
	</div>
	<h3 class="text-lg font-semibold">Thông tin bác sĩ</h3>
	<section class="bg-white p-4 rounded-md border-1 border-gray-300  space-y-4 mt-2">

		<div class="flex items-start space-x-4">
			<img src="@Model.Option.DidNavigation.DoctorImg" alt="Hồ sơ" class="w-12 h-12 rounded-full">
			<div class="flex-1 space-y-2">
				<h4 class="font-semibold text-lg">@Model.Option.DidNavigation.Name</h4>
				<div class="text-gray-500 flex items-center space-x-2">
					<span class="mr-2">@Model.Option.DidNavigation.Specialty.SpecialtyName</span>
					<span>@Model.Option.DidNavigation.Phone</span>
				</div>
			</div>
		</div>
		<div class="flex justify-between text-sm text-gray-700">
			<div class="w-1/2">
				<div class="flex">
					<button onclick="showDesc()" class="font-semibold ml-2 flex">
						<p class="mr-2">Mô tả</p>
					</button>
				</div>
				<p id="doc-desc" class="hidden">@Model.Option.DidNavigation.Description</p>
			</div>
			@if (status == "Complete")
			{
				<div class="w-1/2">
					<div class="flex">
						<p class="font-semibold ml-2">Chẩn đoán</p>
					</div>
					<p>Sâu răng, Lộ dây thần kinh gây đau, Cao răng</p>
				</div>
			}
		</div>
		@if (status == "Complete")
		{
			<div class="bg-gray-100 p-2 rounded-md">
				<p class="text-gray-700">Ghi chú</p>
				<p class="text-sm text-gray-600">@Model.Symptom</p>
			</div>
		}
	</section>

	<!-- Thông tin đặt hẹn -->
	<h3 class="text-lg font-semibold">Thông tin đặt hẹn</h3>
	<section class="bg-white p-4 rounded-md border-1 border-gray-300 space-y-4 mt-2">
		<div class="flex justify-between text-gray-700">
			<div class="w-1/2">
				<div class="flex">
					<p class="font-semibold ml-2">Ngày</p>
				</div>
				<p>@(Model.Option.DateWork.HasValue ? Model.Option.DateWork.Value.ToString("dddd") : "Không có ngày") @Model.Option.DateWork</p>
			</div>
			<div class="w-1/4">
				<div class="flex">
					<p class="font-semibold ml-2">Loại cuộc hẹn</p>
				</div>
				<p class="flex items-center space-x-2">
					<button type="button" class="py-2 px-4 me-2 mb-2 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700">Trực tiếp</button>
				</p>
			</div>
		</div>
		<div class="flex justify-between text-gray-700">
			<div class="w-1/2">
				<div class="flex">
					<p class="font-semibold ml-2">Địa điểm</p>
				</div>
				<p>Bệnh viện Đà Nẵng</p>
			</div>
			<div class="w-1/4">
				<div class="flex">
					<p class="font-semibold ml-2">Giá</p>
				</div>
				<p class="flex items-center space-x-2">
					<button type="button" class="py-2 px-4 me-2 mb-2 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200">@Model.Option.DidNavigation.Price</button>
				</p>
			</div>
		</div>
	</section>
</div>


<section class="bg-white p-4 rounded-md border-1 border-gray-300 space-y-4">
	<h3 class="text-lg font-semibold">Thông tin cá nhân</h3>
	<div class="flex items-start space-x-4">
		<img src="https://cdn-icons-png.flaticon.com/512/3607/3607444.png" alt="Hồ sơ" class="w-12 h-12 rounded-full">
		<div class="flex-1 space-y-2">
			<h4 class="font-semibold text-lg">@Model.PidNavigation.Name</h4>
			<div class="text-gray-500 flex items-center space-x-2">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
					<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
				</svg>

				<span>+ @Model.PidNavigation.Phone</span>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
				</svg>

				<span>@Model.PidNavigation.Dob</span>
			</div>

		</div>
	</div>
	<div class="bg-gray-100 p-2 rounded-md">
		<p class="text-gray-700">Lý do</p>
		<p class="text-sm text-gray-600">@Model.Symptom</p>
	</div>

</section>
</div>

<button id="cancel-modal-button" data-modal-target="cancel-modal" data-modal-toggle="cancel-modal" class="hidden block text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" type="button">
	Chuyển đổi modal
</button>

<div id="cancel-modal" tabindex="-1" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
	<div class="relative p-4 w-full max-w-md max-h-full">
		<div class="relative bg-white rounded-lg shadow dark:bg-gray-700">
			<button type="button" class="absolute top-3 end-2.5 text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-hide="cancel-modal">
				<svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6" />
				</svg>
				<span class="sr-only">Đóng modal</span>
			</button>
			<div class="p-4 md:p-5 text-center">
				<svg class="mx-auto mb-4 text-gray-400 w-12 h-12 dark:text-gray-200" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11V6m0 8h.01M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
				</svg>
				<h3 class="mb-5 text-lg font-normal text-gray-500 dark:text-gray-400">Bạn có chắc chắn muốn hủy đơn hàng này không?</h3>
				<div class="flex">
					<button onclick="submitCancel()" type="button" class="text-white bg-red-600 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 dark:focus:ring-red-800 font-medium rounded-lg text-sm inline-flex items-center px-5 py-2.5 text-center">
						Có, tôi chắc chắn
					</button>
					<button data-modal-hide="cancel-modal" type="button" class="py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700">Không, hủy bỏ</button>
				</div>

			</div>
		</div>
	</div>
</div>
<button id="error-modal-button" data-modal-target="error-modal" data-modal-toggle="error-modal" class="hidden block text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" type="button">
	Chuyển đổi modal
</button>


<div id="error-modal" tabindex="-1" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
	<div class="relative p-4 w-full max-w-md max-h-full">
		<div class="relative bg-white rounded-lg shadow dark:bg-gray-700">
			<button type="button" class="absolute top-3 end-2.5 text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-hide="error-modal" onclick="closeModal()">
				<svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6" />
				</svg>

				<span class="sr-only">Đóng cửa sổ</span>
			</button>
			<div class="p-4 md:p-5 text-center">
				<div id="fb-success" class="hidden">
					<svg class="mx-auto mb-4 text-green-400 w-12 h-12 dark:text-gray-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
					</svg>

				</div>
				<div id="fb-fail" class="hidden">
					<svg class="mx-auto mb-4 text-gray-400 w-12 h-12 dark:text-gray-200" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
						<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11V6m0 8h.01M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
					</svg>
				</div>
				<h3 id="context-notify" class="mb-5 text-lg font-normal text-gray-500 dark:text-gray-400"></h3>
			</div>
		</div>
	</div>
</div>


<input class="hidded" id="orderid" name="orderid" value="@Model.Oid" />
<script>

	function closeModal() {
		console.log("chuyen huong");
	}
	function showDesc() {
		if (document.getElementById('doc-desc').classList.contains('hidden')) {
			document.getElementById('doc-desc').classList.remove('hidden');
			document.getElementById('arrow-down').classList.add('hidden');
			document.getElementById('arrow-up').classList.remove('hidden');
		}
		else {
			document.getElementById('doc-desc').classList.add('hidden');
			document.getElementById('arrow-up').classList.add('hidden');
			document.getElementById('arrow-down').classList.remove('hidden');
		}
	}

	function submitCancel() {
		var oid = document.getElementById('orderid').value;
		$.ajax({
			url: '/Patient/CancelAppointment',
			type: 'POST',
			data: { oid: oid },
			success: function (data) {
				if (data.success == null) {
					document.getElementById('cancel-modal').click();
					document.getElementById('fb-fail').classList.remove('hidden');
					document.getElementById('fb-success').classList.add('hidden');
					document.getElementById('context-notify').innerHTML = data.error;
					document.getElementById('error-modal-button').click();
				}
				else {
					document.getElementById('cancel-modal').click();
					document.getElementById('fb-fail').classList.add('hidden');
					document.getElementById('fb-success').classList.remove('hidden');
					document.getElementById('context-notify').innerHTML = "cancel order success. Please contact our hospital for refunding";
					document.getElementById('error-modal-button').click();
				}

				console.log(data);
			},
			error: function (error) {
				console.log('Error:', error); // Error handling
			}
		});
	}

	function cancelAppointment() {
		document.getElementById('cancel-modal-button').click();

	}

</script>