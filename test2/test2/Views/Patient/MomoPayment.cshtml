@{
    Layout = "Layout_new";
    ViewData["Title"] = "Home Page";
    var postUrl = "tich-hop-thanh-toan-momo-voi-asp-net-core-7d5e4hP";
}

<style>
    /* Đặt nền và căn giữa cho trang */
    body {
        background-color: #f7f9fc;
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
    }

    .text-center {
        margin-top: 30px;
        color: #333;
    }

        /* Tiêu đề trang */
        .text-center h1.display-4 {
            color: #2c3e50;
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .text-center p {
            font-size: 1rem;
            color: #555;
        }

    /* Container form */
    .container {
        max-width: 600px;
        margin: 20px auto;
        padding: 20px;
        background-color: #fff;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
    }

    /* Tiêu đề của từng phần */
    .form-group label {
        color: #333;
        font-weight: bold;
        font-size: 1rem;
        margin-bottom: 5px;
    }

    /* Style cho các input và textarea */
    .form-control {
        width: 100%;
        padding: 10px;
        font-size: 0.9rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        box-sizing: border-box;
        transition: all 0.3s;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0px 0px 5px rgba(50, 152, 219, 0.5);
        }

    /* Khoảng cách giữa các field */
    .form-group {
        margin-bottom: 20px;
    }

    /* Button Thanh toán */
    .btn-primary {
        background-color: #3498db;
        border: none;
        color: #fff;
        padding: 12px 20px;
        font-size: 1rem;
        cursor: pointer;
        transition: background-color 0.3s ease;
        border-radius: 5px;
        width: 100%;
    }

        .btn-primary:hover {
            background-color: #2980b9;
        }

    /* Link trong phần hướng dẫn */
    .text-center a {
        color: #3498db;
        text-decoration: none;
    }

        .text-center a:hover {
            text-decoration: underline;
        }

</style>
<div class="text-center">

    <div class="container">
        <form action="/Patient/CreatePaymentUrl" id="frmCreateOrder" method="POST">
            <!-- Giữ nguyên các field liên quan đến MoMo -->
            <div class="form-group">
                <label for="FullName">Tên khách hàng</label>
                <input class="form-control"
                       id="FullName"
                       name="FullName"
                       type="text"
                       value="ProG Coder">
            </div>
            <br />
            <div class="form-group">
                <label for="Amount">Số tiền</label>
                <input class="form-control"
                       id="Amount"
                       name="Amount"
                       type="text"
                       value="10000">
            </div>
            <br />
            <div class="form-group">
                <label for="OrderInfo">Nội dung thanh toán</label>
                <textarea class="form-control"
                          cols="20"
                          id="OrderInfo"
                          name="OrderInfo"
                          rows="2">Thanh toán tại ProG Coder</textarea>
            </div>
            <br />

            <!-- Các field bổ sung cho thông tin đặt lịch khám bệnh -->
            <div class="form-group">
                <label for="HospitalName">Tên bệnh viện</label>
                <input class="form-control"
                       id="HospitalName"
                       name="HospitalName"
                       type="text"
                       value="Bệnh viện ABC">
            </div>
            <br />
            <div class="form-group">
                <label for="DoctorName">Tên bác sĩ</label>
                <input class="form-control"
                       id="DoctorName"
                       name="DoctorName"
                       type="text"
                       value="Dr. Trần Văn B">
            </div>
            <br />
            <div class="form-group">
                <label for="AppointmentDate">Ngày khám</label>
                <input class="form-control"
                       id="AppointmentDate"
                       name="AppointmentDate"
                       type="date"
                       value="2024-10-10">
            </div>
            <br />
            <div class="form-group">
                <label for="AppointmentTime">Giờ khám</label>
                <input class="form-control"
                       id="AppointmentTime"
                       name="AppointmentTime"
                       type="time"
                       value="10:00">
            </div>
            <br />
            <div class="form-group">
                <label for="ServiceType">Loại dịch vụ khám</label>
                <input class="form-control"
                       id="ServiceType"
                       name="ServiceType"
                       type="text"
                       value="Khám Nội khoa">
            </div>
            <br />
            <div class="form-group">
                <label for="RoomNumber">Phòng khám</label>
                <input class="form-control"
                       id="RoomNumber"
                       name="RoomNumber"
                       type="text"
                       value="Phòng 101">
            </div>
            <br />

            <!-- Nút Thanh Toán -->
            <button type="submit" class="btn btn-primary">Thanh toán (Checkout)</button>
        </form>
    </div>
</div>

<script>
    $(document).ready(function () {

    });
</script>
