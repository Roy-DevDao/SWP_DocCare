@model test2.Models.Momo.MomoExecuteResponseModel

@{
    ViewData["Title"] = "Kết Quả Thanh Toán";
    
}

<div class="text-center">
    <h1 class="display-4">Kết Quả Thanh Toán</h1>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container">
            <h1 class="text-success">Thanh Toán Thành Công</h1>
            <p>Order ID: <strong>@Model.OrderId</strong></p>
            <p>Amount: <strong>@Model.Amount</strong></p>
            <p>Order Info: <strong>@Model.OrderInfo</strong></p>
        </div>
    }
    else
    {
        <h2>Thanh Toán Thất Bại</h2>
    }
    
</div>

<script>
    $(document).ready(function () {
            // Bạn có thể thêm bất kỳ mã JavaScript nào nếu cần
    });
</script>

