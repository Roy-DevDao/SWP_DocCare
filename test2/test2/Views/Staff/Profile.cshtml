@model test2.Models.UserProfileViewModel
@{
    ViewBag.Title = "Sửa trang cá nhân";
    Layout = "~/Views/Shared/Layout_Staff.cshtml";
}
@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
}


<style>
    /* Reset các margin và padding */
   

    .main-point{
        width: 90%;
        margin-left: auto;
        margin-right: auto;
        padding: 20px 40px;
        background-color: white;
        border-radius: 10px;
        border: 1px solid #ddd; /* Viền mỏng màu xám nhạt cho các ô */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Bóng mờ xung quanh bảng */
    }
    .mt-2{
        border: 1px solid #ddd; border-radius: 10px; 
    }

</style>



<div class="main-point">
    <!-- Form Update Thông Tin -->
    <form name="reg-form" method="post" id="frmEdit" enctype="multipart/form-data">
        <div class="border-b border-gray-900/10 pb-12">
            <h1 class="text-base font-semibold text-black-900">Thông tin cá nhân</h1>
            <p class="mt-1 text-sm text-gray-500">Cập nhật thông tin cá nhân của bạn.</p>

            <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                <!-- Tên -->
                <div class="sm:col-span-3">
                    <label for="full-name" class="block text-sm font-medium text-gray-900">Tên</label>
                    <div class="mt-2" style="border: 1px solid #ddd; border-radius: 10px; ">
                        <input type="text" name="FullName" id="full-name" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" style="padding: 5px 10px;" required value="@Model.StaffName">
                    </div>
                </div>

                <!-- Giới tính -->
                <div class="sm:col-span-3">
                    <label for="gender" class="block text-sm font-medium text-gray-900">Giới tính</label>
                    <div class="mt-2" style="border: 1px solid #ddd; border-radius: 10px; ">
                        <select name="Gender" id="gender" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" required>
                            <option value="">---- Lựa chọn ----</option>
                            <option value="male" selected="@(Model.SGender == "male")">Nam</option>
                            <option value="female" selected="@(Model.SGender == "female")">Nữ</option>
                        </select>
                    </div>
                </div>

                <!-- Tên đăng nhập -->
                <div class="sm:col-span-3">
                    <label for="username" class="block text-sm font-medium text-gray-900">Tên đăng nhập</label>
                    <div class="mt-2" style="border: 1px solid #ddd; border-radius: 10px; ">
                        <input style="padding: 5px 10px;" type="text" name="Username" id="username" style="padding: 5px 10px;" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" required disabled value="@Model.Username">
                    </div>
                </div>

                <!-- Điện thoại -->
                <div class="sm:col-span-3">
                    <label for="phone" class="block text-sm font-medium text-gray-900">Điện thoại</label>
                    <div class="mt-2" style="border: 1px solid #ddd; border-radius: 10px; ">
                        <input type="text" name="Phone" id="phone" style="padding: 5px 10px;" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" disabled value="@Model.SPhone">
                    </div>
                </div>

                <!-- Email -->
                <div class="sm:col-span-3">
                    <label for="email" class="block text-sm font-medium text-gray-900">Email</label>
                    <div class="mt-2" style="border: 1px solid #ddd; border-radius: 10px; ">
                        <input type="email" style="padding: 5px 10px;" name="Email" id="email" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" disabled value="@Model.Email">
                    </div>
                </div>

                <!-- Ngày sinh -->
                <div class="sm:col-span-3">
                    <label for="date-of-birth" class="block text-sm font-medium text-gray-900">Ngày sinh</label>
                    <div class="mt-2" style="border: 1px solid #ddd; border-radius: 10px; ">
                        <input type="date" name="DateOfBirth" style="padding: 5px 10px;" id="date-of-birth" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" required value="@Model.SDob?.ToDateTime(new TimeOnly()).ToString("yyyy-MM-dd")">
                    </div>
                </div>

                <!-- Ảnh đại diện -->
                <div class="sm:col-span-6">
                    <label for="file" class="block text-sm font-medium text-gray-900">Ảnh đại diện</label>
                    <div class="mt-3">
                        <input type="file" name="avataUpload" id="file" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm">
                        <p class="text-sm text-gray-600">Upload ảnh đại diện.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-6 flex items-center justify-end gap-x-6">
            <button type="button" class="text-sm font-semibold text-gray-900">Hủy</button>
            <button type="submit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Cập nhật</button>
        </div>
    </form>

    <!-- Form Đổi Mật Khẩu -->
    <form name="editprofile-form" method="post" asp-controller="Staff" asp-action="ChangePassword" id="updatePass" class="mt-10">
        <div class="border-b border-gray-900/10 pb-12">
            <h2 class="text-base font-semibold text-gray-900">Đổi mật khẩu</h2>
            <p class="mt-1 text-sm text-gray-600">Mật khẩu cần thay đổi thường xuyên vì lý do bảo mật.</p>

            <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                <!-- Mật khẩu mới -->
                <div class="sm:col-span-3">
                    <label for="new-password" class="block text-sm font-medium text-gray-900">Mật khẩu mới</label>
                    <div class="mt-2" style="border: 1px solid #ddd; border-radius: 10px; ">
                        <input type="password" name="NewPassword" id="new-password" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm">
                    </div>
                </div>

                <!-- Nhập lại mật khẩu -->
                <div class="sm:col-span-3">
                    <label for="re-password" class="block text-sm font-medium text-gray-900">Nhập lại mật khẩu</label>
                    <div class="mt-2">
                        <input type="password" name="RePassword" id="re-password" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm">
                    </div>
                </div>

                <!-- Mật khẩu cũ -->
                <div class="sm:col-span-6">
                    <label for="old-password" class="block text-sm font-medium text-gray-900">Mật khẩu cũ</label>
                    <div class="mt-2">
                        <input type="password" name="OldPassword" id="old-password" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm">
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-6 flex items-center justify-end gap-x-6">
            <button type="button" class="text-sm font-semibold text-gray-900">Hủy</button>
            <button type="submit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Cập nhật</button>
        </div>
    </form>
</div>


